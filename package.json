{
  "name": "katana-ui",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @katana-ui/react dev",
    "check": "pnpm -r --workspace-concurrency=1 run check",
    "test": "pnpm -r --workspace-concurrency=1 run check && pnpm -r --workspace-concurrency=1 run test",
    "typecheck": "pnpm -r run typecheck",
    "build:site": "pnpm --filter @katana-ui/react build:site",
    "tokens:sync": "pnpm --filter @katana-ui/tokens tokens:sync",
    "ui:coverage": "pnpm --filter @katana-ui/react ui:coverage",
    "ds:build": "pnpm --filter @katana-ui/react ds:build",
    "test:e2e": "pnpm --filter @katana-ui/react test:e2e",
    "fast": "pnpm --filter @katana-ui/react fast",
    "vr": "pnpm --filter @katana-ui/react vr",
    "vr:fast": "pnpm --filter @katana-ui/react vr:fast",
    "vr:update": "pnpm --filter @katana-ui/react vr:update",
    "vr:approve": "pnpm --filter @katana-ui/react vr:approve",
    "vr:summary": "pnpm --filter @katana-ui/react vr:summary",
    "full": "pnpm --filter @katana-ui/react full"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@12.23.0"
}
