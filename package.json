{
  "name": "katana-ui",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @katana-ui/react dev",
    "check": "pnpm -r --workspace-concurrency=1 run check",
    "test": "pnpm -r --workspace-concurrency=1 run check && pnpm -r --workspace-concurrency=1 run test",
    "typecheck": "pnpm -r run typecheck",
    "build:site": "pnpm --filter @katana-ui/react build:site",
    "tokens:sync": "pnpm --filter @katana-ui/tokens tokens:sync",
    "ds:build": "pnpm --filter @katana-ui/react ds:build"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@12.18.0"
}
