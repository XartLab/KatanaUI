{
  "name": "@katanaview/ui",
  "version": "0.0.0",
  "private": true,
  "description": "KATANAview 自己的组件框架：设计 token、Tailwind 主题、动效，以及 Radix 底座的基础件（起步代码取自 shadcn/ui）。不依赖应用与其他 @katanaview 包（决策记录 0049）。",
  "license": "MIT",
  "files": [
    "src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "./gallery/main.tsx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./ui.css": "./src/ui.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./motion": "./src/lib/motion.ts",
    "./quant": "./src/quant/index.ts",
    "./quant/format": "./src/quant/format/index.ts",
    "./blocks": "./src/blocks/index.ts"
  },
  "scripts": {
    "dev": "vp dev",
    "build:site": "node scripts/build-site.mjs",
    "test": "vp test run",
    "typecheck": "tsc -p tsconfig.json",
    "check": "vp check",
    "ds:build": "node scripts/ds-build.mjs",
    "registry:build": "node scripts/registry-json.mjs && shadcn build -o r"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.25",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "d3-hierarchy": "3.1.3",
    "lucide-react": "1.67.0",
    "motion": "14.9.0",
    "radix-ui": "1.8.1",
    "react-aria-components": "1.22.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.22.2",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.20.0"
}
