{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src",
    "gallery",
    "ds",
    "scripts",
    "e2e",
    "browser",
    "vitest.browser.config.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "happo.config.ts",
    "pixelgate.config.ts",
    "pixelgate.hidpi.config.ts",
    "pixelgate.shared.ts",
    "pixelgate.vite.config.ts",
    "pixelgate.fast.config.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "gallery/**/*.test.tsx",
    "ds/**/*.test.ts",
    "ds/**/*.test.tsx",
    "scripts/**/*.test.ts"
  ]
}
