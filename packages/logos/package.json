{
  "name": "@katana-ui/logos",
  "version": "0.2.0",
  "private": true,
  "description": "Katana UI 的徽标解析：品种代码规范化（代码.场所 + ISO MIC）、可插拔的来源（加密币取 @web3icons/core 的 SVG、应用自托管、地址模板）、内存缓存与失败缓存、React 的 LogoProvider / useLogo，以及把徽标下载到应用目录的命令行 katana-logos。不打包任何企业商标图片。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XartLab/KatanaUI.git",
    "directory": "packages/logos"
  },
  "bin": {
    "katana-logos": "./bin/katana-logos.mjs"
  },
  "files": [
    "src",
    "lib",
    "bin",
    "LICENSE",
    "katana-logos.config.example.json",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "katana-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./web3icons": {
      "katana-source": "./src/web3icons.ts",
      "types": "./lib/web3icons.d.ts",
      "default": "./lib/web3icons.js"
    },
    "./react": {
      "katana-source": "./src/react.tsx",
      "types": "./lib/react.d.ts",
      "default": "./lib/react.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm run build",
    "test": "node scripts/sync-web3icons.mjs --check && vp test run",
    "check": "vp check",
    "typecheck": "tsc -p tsconfig.json",
    "web3icons:sync": "node scripts/sync-web3icons.mjs"
  },
  "dependencies": {
    "@web3icons/core": "4.0.61"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13"
  }
}
